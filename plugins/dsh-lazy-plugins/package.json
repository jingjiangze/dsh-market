{
  "name": "@local/dsh-lazy-plugins",
  "version": "3.90.0",
  "private": true,
  "type": "module",
  "description": "按需加载市场插件：一句话需求自动挑装、proxy 隐藏工具保持提示词缓存、已装插件也可纳入按需（adopt）、过期版本一键更新。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "data/*.json",
    "skills/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CREDITS.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "plugin-market",
    "on-demand",
    "lazy-load",
    "prompt-cache",
    "proxy-tools"
  ],
  "dependencies": {
    "onnxruntime-node": "^1.20.1"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.20.1"
  }
}
