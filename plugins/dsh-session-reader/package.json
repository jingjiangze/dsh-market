{
  "name": "@local/dsh-session-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read other DSH sessions: list, cross-session literal search, and read one full conversation (read-only).",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CREDITS.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
