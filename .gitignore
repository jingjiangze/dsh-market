# Generated by the crawl and published to the ModelScope dataset, never to git.
dist/browse/
dist/icons/
dist/part-*.json
dist/rejections.json
dist/index.*.json
dist/index.sidecar.json
# dist/index.json is a build product: the site renders from the browse chunks and
# DSH subscribes to site/index.zh.json, so this 12 MB document only ever bloated the
# history. dist/stats.json stays tracked because the deploy step publishes it.
dist/index.json
_tmp/

# A local `npm i` of the validator must never be published.
node_modules/
package-lock.json

# Derived documents: regenerated by every run, nothing reads them from git.
# site/index.zh.json is the exception — it is the DSH subscription link and must be
# served by GitHub Pages, which reads from git.
site/index.json
site/sidecar.json
site/index.en.json
site/index.ja.json
site/index.ko.json
site/index.ru.json
